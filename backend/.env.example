# Optional — without these, the API still works using a local curated
# phone catalogue as the recommendation source (recommendation_source: "local_fallback").

# Get a key at https://tavily.com
TAVILY_API_KEY=

# Get a key at https://console.anthropic.com — used to structure raw
# Tavily search results into clean JSON recommendations.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
